expression DataFolder =
		"C:\Users\oem\Desktop\pbidados\power-bi-financial-challenge\challenge-data-transformation\data\raw" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]
	lineageTag: 09b24bf8-0a25-4148-97c3-fe8a7c9e753f
	queryGroup: Parameters
	annotation PBI_NavigationStepName = Navigation
	annotation PBI_ResultType = Text

expression CompanyCsv =
		(fileName as text, columnTypes as list) as table =>
		    let
		        Source = Csv.Document(
		            File.Contents(DataFolder & "\" & fileName),
		            [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
		        ),
		        Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		        Typed = Table.TransformColumnTypes(Headers, columnTypes, "en-US")
		    in
		        Typed
	lineageTag: 3a57f5bf-d982-416f-a679-4e72bceaead0
	queryGroup: Tables
	annotation PBI_NavigationStepName = Navigation
	annotation PBI_ResultType = Function
