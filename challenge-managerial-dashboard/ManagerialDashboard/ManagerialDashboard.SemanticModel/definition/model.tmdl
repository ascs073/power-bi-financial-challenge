model ManagerialDashboard
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters
	annotation PBI_QueryGroupOrder = 0

queryGroup Tables
	annotation PBI_QueryGroupOrder = 1

ref table DimDate
ref table DimProduct
ref table DimCountry
ref table DimSegment
ref table DimDiscountBand
ref table FactSales

relationship FactSales_DimDate_DateKey
	fromColumn: FactSales.DateKey
	toColumn: DimDate.DateKey
	crossFilteringBehavior: oneDirection
	isActive: true

relationship FactSales_DimProduct_ProductKey
	fromColumn: FactSales.ProductKey
	toColumn: DimProduct.ProductKey
	crossFilteringBehavior: oneDirection
	isActive: true

relationship FactSales_DimCountry_CountryKey
	fromColumn: FactSales.CountryKey
	toColumn: DimCountry.CountryKey
	crossFilteringBehavior: oneDirection
	isActive: true

relationship FactSales_DimSegment_SegmentKey
	fromColumn: FactSales.SegmentKey
	toColumn: DimSegment.SegmentKey
	crossFilteringBehavior: oneDirection
	isActive: true

relationship FactSales_DimDiscountBand_DiscountBandKey
	fromColumn: FactSales.DiscountBandKey
	toColumn: DimDiscountBand.DiscountBandKey
	crossFilteringBehavior: oneDirection
	isActive: true
