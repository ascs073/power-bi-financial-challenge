table DimDate
	lineageTag: 53900160-749e-4f52-b8f2-8704360eeccf

	column DateKey
		dataType: int64
		summarizeBy: none
		sourceColumn: DateKey
		isKey

	column Date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: Date

	column Year
		dataType: int64
		summarizeBy: none
		sourceColumn: Year
		formatString: 0

	column Quarter
		dataType: string
		summarizeBy: none
		sourceColumn: Quarter

	column MonthNumber
		dataType: int64
		summarizeBy: none
		sourceColumn: MonthNumber
		formatString: 0

	column MonthName
		dataType: string
		summarizeBy: none
		sourceColumn: MonthName

	column YearMonth
		dataType: string
		summarizeBy: none
		sourceColumn: YearMonth
		sortByColumn: YearMonthSort

	column YearMonthSort
		dataType: int64
		summarizeBy: none
		sourceColumn: YearMonthSort
		formatString: 0

	partition DimDate = m
		mode: import
		queryGroup: Tables
		source = ```
			let
			    DimDate = CsvTable(
			        "DimDate.csv",
			        {
			            {"DateKey", Int64.Type}, {"Date", type date}, {"Year", Int64.Type},
			            {"Quarter", type text}, {"MonthNumber", Int64.Type},
			            {"MonthName", type text}, {"YearMonth", type text},
			            {"YearMonthSort", Int64.Type}
			        }
			    ),
			    DimProduct = CsvTable(
			        "DimProduct.csv",
			        {
			            {"ProductKey", Int64.Type}, {"ProductName", type text},
			            {"ManufacturingPrice", type number}
			        }
			    ),
			    DimCountry = CsvTable(
			        "DimCountry.csv",
			        {{"CountryKey", Int64.Type}, {"CountryName", type text}}
			    ),
			    DimSegment = CsvTable(
			        "DimSegment.csv",
			        {{"SegmentKey", Int64.Type}, {"SegmentName", type text}}
			    ),
			    DimDiscountBand = CsvTable(
			        "DimDiscountBand.csv",
			        {{"DiscountBandKey", Int64.Type}, {"DiscountBand", type text}}
			    ),
			    FactSales = CsvTable(
			        "FactSales.csv",
			        {
			            {"FactRowID", Int64.Type}, {"DateKey", Int64.Type},
			            {"ProductKey", Int64.Type}, {"CountryKey", Int64.Type},
			            {"SegmentKey", Int64.Type}, {"DiscountBandKey", Int64.Type},
			            {"UnitsSold", type number}, {"ManufacturingPrice", type number},
			            {"SalePrice", type number}, {"GrossSales", type number},
			            {"Discounts", type number}, {"NetSales", type number},
			            {"COGS", type number}, {"Profit", type number}
			        }
			    ),
			    Result = DimDate
			in
			    Result
			```

	annotation PBI_ResultType = Table
